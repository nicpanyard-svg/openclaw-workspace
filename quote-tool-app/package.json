{
  "name": "quote-tool-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:vercel": "npm run build && node scripts/ensure-vercel-routes-manifest.cjs",
    "start": "next start",
    "lint": "eslint app scripts proxy.ts next.config.ts",
    "test": "node scripts/run-tests.cjs",
    "typecheck": "tsc --noEmit",
    "check:release": "npm run lint && npm run typecheck && npm test && npm run build:vercel",
    "check:config": "node scripts/check-config.cjs",
    "test:smoke": "tsx scripts/verify-handoff.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "5.27.0",
    "@formulajs/formulajs": "4.5.6",
    "@react-pdf/renderer": "^4.5.1",
    "@sparticuz/chromium": "^147.0.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.41.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "puppeteer-core": "^24.41.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-calc": "0.9.2"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "4.20.6",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
