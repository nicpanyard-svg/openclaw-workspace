# Copy to .env.local for development. Never commit secrets.
# Build-time company branding and existing browser-storage namespace.
NEXT_PUBLIC_RAPIDQUOTE_ENV=inet

# Optional Outlook sending. Single-tenant Entra SPA registration, delegated Mail.Send.
# Public identifiers only. Never add a Microsoft client secret to this browser integration.
# Register <app-origin>/outlook-callback as a Single-page application redirect URI.
# See docs/outlook-docusign-setup.md. Rebuild after changing these values.
# NEXT_PUBLIC_RAPIDQUOTE_MICROSOFT_CLIENT_ID=
# NEXT_PUBLIC_RAPIDQUOTE_MICROSOFT_TENANT_ID=

# Existing browser workflow remains the default. DevOps enables this for hosted pilots.
# RAPIDQUOTE_ACCESS_MODE=restricted
# RAPIDQUOTE_ACCESS_USER=
# RAPIDQUOTE_ACCESS_PASSWORD=

# Required for PDF export outside localhost. HTTPS origin only, no path.
# RAPIDQUOTE_APP_ORIGIN=https://your-rapidquote-host.example

# Optional server-side AI extraction. Leave unset for deterministic parsing only.
# OPENAI_API_KEY=
# OPENAI_DOCUMENT_EXTRACTION_MODEL=gpt-4o

# Local PDF generation (Chrome/Edge must be installed); serverless uses bundled Chromium.
# PUPPETEER_EXECUTABLE_PATH=

# Only if Vercel Deployment Protection is enabled, for the internal PDF browser.
# VERCEL_AUTOMATION_BYPASS_SECRET=
